import modules.settings as cfg;
import modules.map_data.Loc as Loc;
import modules.unit_settings.UnitModel as UnitModel;
import modules.unit_data as unitData;
import modules.damage_types.AttackType as AttackType;
import modules.damage_types.AttackLabel as AttackLabel;
import modules.damage_types.AttackIcon as AttackIcon;
import modules.start_ui as ui;
import modules.income as income;
import modules.cities as cities;
import modules.nexus as nexus;

const NEXT_UNIT = EPD(0x628438);
const LOCATION_TABLE = EPD(0x58DC60);
const VALUES = EUDVArray(8)(py_eval('[10000] * 8'));
const COUNTS = EUDVArray(8)(py_eval('[1] * 8'));
const SELECTED_UNITS = EPD(0x6284E8); // 플레이어별 동기화된 선택 목록, 12슬롯
const UNIT_INSPECT = EUDVArray(8)();
const LAST_BUILD_ORDER = EUDVArray(8)();
const LAST_BUILD_UNIT = EUDVArray(8)();
const unitScreen = StringBuffer(1024);

function checkGroupUnique(unit : CUnit, stored) {
    const current = unit.uniquenessIdentifier;
    if (stored != current) {
        printAll("\x08[UnitGroup 오류] EPD={} 저장 식별자={} 현재 식별자={}",
                 unit, stored, current);
    }
}

// chatEvent가 제공하는 포인터·패턴은 로컬 값. 게임 상태 변경 전에 MSQC로 전송.
var chatPtr = 0;
var chatPattern = 0;
var patternSend = 0;
var valueSend = 0;
const PATTERN_RECEIVED = PVariable();
const VALUE_RECEIVED = PVariable();
EUDRegisterObjectToNamespace("debugChatPtr", chatPtr);
EUDRegisterObjectToNamespace("debugChatPattern", chatPattern);
EUDRegisterObjectToNamespace("debugPatternSend", patternSend);
EUDRegisterObjectToNamespace("debugValueSend", valueSend);
EUDRegisterObjectToNamespace("debugPatternReceived", PATTERN_RECEIVED);
EUDRegisterObjectToNamespace("debugValueReceived", VALUE_RECEIVED);

function init() {
    if (!cfg.DEBUG_ENABLED) { return; }
    UnitModel.debug_marine.nameString = "\x04디버그 마린";
    UnitModel.debug_marine.groundWeapon.damage = 2000;
    UnitModel.debug_marine.groundWeapon.damageBonus = 0;
    UnitModel.debug_marine.groundWeapon.damageType = AttackType.general;
    UnitModel.debug_marine.groundWeapon.label = AttackLabel.general;
    UnitModel.debug_marine.groundWeapon.icon = AttackIcon.general;
    UnitModel.debug_marine.airWeapon.damage = 2000;
    UnitModel.debug_marine.airWeapon.damageBonus = 0;
}

function captureChat() {
    patternSend = 0;
    valueSend = 0;
    if (!cfg.DEBUG_ENABLED) { return; }
    foreach (command, prefixLength : cfg.DEBUG_PATTERNS) {
        if (chatPattern == command) {
            var value = parse(chatPtr + prefixLength)[[0]];
            if (value > 2000000000) { value = 2000000000; }
            // val 한 채널의 24비트 한도: 상위 바이트는 명령과 묶어서 전송.
            valueSend = value & 0xFFFFFF;
            patternSend = (command << 8) + (value >> 24);
        }
    }
}

function help() {
    println("\x04선택 유닛 확인: 디버그 유닛 (표시 켜기/끄기)");
    println("\x06[디버그] 디버그 돈 50000 / 디버그 가스 50000 / 디버그 자원 50000");
    println("\x04생성: 디버그 마린 10 (짐 레이너, 공격력 2000) / 디버그 창병 10 / 디버그 SCV 1");
    println("\x04디버그 병종: 현재 설정한 기본 병종과 공성 터렛을 마우스 위치에 각각 1기 생성");
    println("\x04타이머: 디버그 세금타이머 10 / 디버그 주둔군타이머 120 / 디버그 시작타이머 120");
    println("\x04기본값 변경: 디버그 값 10000 / 디버그 개수 10. 숫자 생략 시 기본값 적용.");
    println("\x04유닛 생성·주둔군 타이머는 내 마우스 위치 기준. 세금은 남은 초, 나머지 타이머는 트리거 틱.");
}

function inspectSelected(player : TrgPlayer) {
    if (UNIT_INSPECT[player] == 0) { return; }
    const slot = SELECTED_UNITS + 12 * player;
    if (MemoryEPD(slot, Exactly, 0)) { return; }
    const unit = CUnit.cast(cunitepdread_epd(slot)[[1]]);
    const order = maskread_epd(unit + 0x4C / 4, 0xFF00) >> 8;
    const state = maskread_epd(unit + 0x4C / 4, 0xFF0000) >> 16;
    const kind = maskread_epd(unit + 0x64 / 4, 0xFF);
    const owner = maskread_epd(unit + 0x4C / 4, 0xFF);
    const build = maskread_epd(unit + 0x98 / 4, 0xFFFF);
    epdswitch(unit + 0x4C / 4, 0xFF00) {
        case 30 << 8:
        case 31 << 8:
        case 32 << 8:
        case 70 << 8:
            LAST_BUILD_ORDER[player] = order;
            LAST_BUILD_UNIT[player] = build;
            break;
    }
    if (player != getuserplayerid()) { return; }
    const textPointer = gettextptr();
    var sameCapital = 0;
    if (unit == nexus.NEXUS[player]) { sameCapital = 1; }
    unitScreen.insert(0);
    unitScreen.appendf("\x04선택 EPD={} 종류={} 소유={} 명령={} 상태={} 건설={}\n",
        unit, kind, owner, order, state, build);
    unitScreen.appendf("\x04저장 수도 EPD={} 일치={} 활성={} 세대={} 선택 세대={}\n",
        nexus.NEXUS[player], sameCapital, nexus.ACTIVE[player], nexus.GENERATION[player], unit.uniquenessIdentifier);
    unitScreen.appendf("\x04최근 건설 명령={} 대상={} (테란30 / 프로토스31,32 / 저그70)",
        LAST_BUILD_ORDER[player], LAST_BUILD_UNIT[player]);
    setcurpl(player);
    unitScreen.Display();
    dwwrite(0x640B58, textPointer); // 디버그 출력으로 채팅 스크롤을 밀지 않음
}

function setMinerals(player, amount) {
    SetResources(player, SetTo, amount, Ore);
}

function setGas(player, amount) {
    SetResources(player, SetTo, amount, Gas);
}

function spawn(player, unit : TrgUnit, count) {
    if (count == 0) { return; }
    if (count > 255) { count = 255; }
    if (MemoryEPD(NEXT_UNIT, Exactly, 0)) {
        println("\x08[디버그] 생성 가능한 유닛 슬롯이 없습니다.");
        return;
    }
    const mouse = LOCATION_TABLE + (Loc.mouse_p1 - 1 + player) * 5;
    const x = maskread_epd(mouse, 0x1FFF);
    const y = maskread_epd(mouse + 1, 0x1FFF);
    setloc(Loc.city_spawn, x, y);
    dilateloc(Loc.city_spawn, 16, 16);
    CreateUnit(count, unit, Loc.city_spawn, player);
}

function setTaxTimer(seconds) {
    SetCountdownTimer(SetTo, seconds);
    income.timerStarted = 1;
}

function spawnRoster(player) {
    // JSON 병종 목록을 빌드 때 펼칩니다. 신규 병종도 이 명령에 자동 포함.
    // 건물을 먼저 배치해 병력이 건설 위치를 선점하지 않도록 합니다.
    foreach (unit : unitData.DEBUG_ROSTER) {
        spawn(player, unit, 1);
    }
}

function setGarrisonTimer(player, ticks) {
    const mouse = LOCATION_TABLE + (Loc.mouse_p1 - 1 + player) * 5;
    const targetX = maskread_epd(mouse, 0x1FFF);
    const targetY = maskread_epd(mouse + 1, 0x1FFF);
    // 0도 다음 도시 처리에서 정상 회수하도록 1로 설정.
    if (ticks == 0) { ticks = 1; }
    if (ticks > 65535) { ticks = 65535; }
    var changed = 0;
    for (var index = 0; index < cities.registeredCities; index++) {
        const city = cities.CITY_UNITS[index];
        if (MemoryXEPD(city + 0x4C / 4, Exactly, 0, 0xFF00)) { continue; }
        if (MemoryEPD(city + 0x8C / 4, Exactly, 0)) { continue; }
        const x, y = posread_epd(city + 0x28 / 4);
        if (x <= targetX + 160 && targetX <= x + 160 &&
            y <= targetY + 160 && targetY <= y + 160) {
            city.unknown0x8C = ticks;
            changed++;
        }
    }
    println("\x04[디버그] 전투 도시 {}곳의 주둔군 타이머를 {}틱으로 설정", changed, ticks);
}

function setStartTimer(ticks) {
    if (ui.started != 0 || ui.stage != 6) {
        println("\x08[디버그] 거점 선택 완료 후 시작 카운트다운 중에 사용하세요.");
        return;
    }
    // 값은 시작 카운트다운의 경과 틱. START_COUNTDOWN 이상이면 시작.
    ui.countdown = ticks;
}

function execute(player, command) {
    switch (command) {
        case 100: help(); break;
        case 101: setMinerals(player, VALUES[player]); break;
        case 102: setGas(player, VALUES[player]); break;
        case 103:
            setMinerals(player, VALUES[player]);
            setGas(player, VALUES[player]);
            break;
        case 104: spawn(player, UnitModel.debug_marine, COUNTS[player]); break;
        case 105: spawn(player, UnitModel.scv, COUNTS[player]); break;
        case 106: setTaxTimer(VALUES[player]); break;
        case 107: setGarrisonTimer(player, VALUES[player]); break;
        case 108: setStartTimer(VALUES[player]); break;
        case 109: UNIT_INSPECT[player] = 1 - UNIT_INSPECT[player]; break;
        case 111: spawn(player, UnitModel.spearman, COUNTS[player]); break;
        case 112: spawnRoster(player); break;
    }
}

function tick() {
    if (!cfg.DEBUG_ENABLED) { return; }
    foreach (cp : EUDLoopPlayer("Human")) {
        if (cp >= 7) { continue; }
        setcurpl(cp);
        const packet = PATTERN_RECEIVED[cp];
        if (packet >= 256 && packet < 3072) {
            const command = packet >> 8;
            var value = VALUE_RECEIVED[cp] + ((packet & 0xFF) << 24);
            PATTERN_RECEIVED[cp] = 0;
            VALUE_RECEIVED[cp] = 0;
            if (command == 4 || command == 5 || command == 10 || command == 11) {
                if (value > 255) { value = 255; }
                COUNTS[cp] = value;
            } else {
                VALUES[cp] = value;
            }
            if (command <= 8 || command == 11) { execute(cp, command + 100); }
            println("\x04[디버그] 값 {} · 생성 개수 {}", VALUES[cp], COUNTS[cp]);
        }
        const command = ui.chatReceived[cp];
        if (command >= 100 && command <= 112) {
            ui.chatReceived[cp] = 0;
            execute(cp, command);
            println("\x04[디버그] 값 {} · 생성 개수 {}", VALUES[cp], COUNTS[cp]);
        }
        inspectSelected(cp);
    }
    setcurpl(0);
}
