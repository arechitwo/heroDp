const ARMY = UnitGroup(1700);
const COMMANDS = EUDArray(8);

function trackNewUnits() {
    foreach (ptr, epd : EUDLoopNewUnit()) {
        const unit = CUnit.cast(epd);
        const kind = unit.unitType;
        if (unit.owner >= 7 || kind == 7 || kind == 41 || kind == 64 || kind == 40 || kind >= 106 || kind == 101) { continue; }
        ARMY.add(unit);
    }
}

function tick() {
    trackNewUnits();
    var hasCommand = 0;
    foreach (cp : EUDLoopPlayer("Human")) {
        if (cp < 7) {
            setcurpl(cp);
            COMMANDS[cp] = 0;
            if (Deaths(CurrentPlayer, Exactly, 1, 214)) { COMMANDS[cp] = 1; hasCommand = 1; }
            else if (Deaths(CurrentPlayer, Exactly, 2, 214)) { COMMANDS[cp] = 2; hasCommand = 1; }
            SetDeaths(CurrentPlayer, SetTo, 0, 214);
        }
    }
    if (hasCommand) {
        // One army traversal for all players' commands, never one global scan per player.
        foreach (entry : ARMY.cploop) {
            const unit = CUnit.cast(entry.epd);
            const owner = unit.owner;
            if (owner >= 7) { continue; }
            const mode = COMMANDS[owner];
            if (mode == 0) { continue; }
            unit.setloc(254);
            if (mode == 2) { Order(unit.unitType, owner, 254, Attack, 240 + owner); }
            else { Order(unit.unitType, owner, 254, Move, 240 + owner); }
        }
    }
    setcurpl(0);
}
