import modules.unit_orders as orders;
import modules.army_groups as groups;
import modules.unit_settings.UnitModel as UnitModel;
import modules.map_data.Loc as Loc;
import modules.nexus as nexus;
import modules.construction as construction;
import modules.army_camp as armyCamp;
import modules.recovery_camp as recoveryCamp;

const COMMANDS = EUDVArray(8)();
const TARGET_POSITIONS = EUDVArray(8)();
const LOCATION_TABLE = EPD(0x58DC60);

function trackNewUnits() {
    foreach (ptr, epd : EUDLoopNewUnit()) {
        epdswitch(epd + 0x64 / 4, 0xFF) {
            case unProxy(UnitModel.army_camp):
                armyCamp.track(epd);
                continue;
            case unProxy(UnitModel.hero_hall):
                armyCamp.trackHeroHall(epd);
                continue;
            case unProxy(UnitModel.recovery_camp):
                recoveryCamp.track(CUnit.cast(epd));
                continue;
            case unProxy(UnitModel.metropolis):
                if (!construction.acceptNewMetropolis(CUnit.cast(epd))) { continue; }
                nexus.trackMetropolis(epd);
                continue;
        }
        if (MemoryXEPD(epd + 0x4C / 4, AtLeast, 7, 0xFF)) { continue; }
        if (MemoryXEPD(epd + 0x64 / 4, AtLeast, 106, 0xFF)) { continue; }
        epdswitch(epd + 0x64 / 4, 0xFF) {
            case unProxy(UnitModel.scv):
                groups.add_default(epd); // 공병도 일반 군사로 등록.
                break;
            case unProxy(UnitModel.defender):
            case unProxy(UnitModel.drone):
            case unProxy(UnitModel.probe):
            case unProxy(UnitModel.map_revealer):
                break;
            default:
                groups.add_default(epd);
                break;
        }
    }
}

function tick() {
    var hasCommand = 0;
    foreach (cp : EUDLoopPlayer("Human")) {
        if (cp < 7) {
            setcurpl(cp);
            COMMANDS[cp] = 0;
            if (Deaths(CurrentPlayer, Exactly, 1, 214)) { COMMANDS[cp] = 1; hasCommand = 1; }
            else if (Deaths(CurrentPlayer, Exactly, 2, 214)) { COMMANDS[cp] = 2; hasCommand = 1; }
            if (COMMANDS[cp] != 0) {
                // 플레이어당 목표 좌표를 한 번만 읽고 해당 군대 전체에서 재사용.
                const loc = LOCATION_TABLE + (Loc.mouse_p1 - 1 + cp) * 5;
                // MRGN은 X/Y가 별도 DWORD이므로 각 좌표의 하위 13비트만 읽음.
                const x = maskread_epd(loc, 0x1FFF);
                const y = maskread_epd(loc + 1, 0x1FFF);
                TARGET_POSITIONS[cp] = x + (y << 16);
            }
            SetDeaths(CurrentPlayer, SetTo, 0, 214);
        }
    }
        // 매 틱 수명 관리. 명령이 있을 때에만 저장된 유닛에 직접 명령을 기록.
    // Registry expands at compile time: each player's default/hero groups get one pass.
    recoveryCamp.prepare();
    foreach (player, army : groups.REGISTERED_GROUPS) {
        foreach (entry : army.cploop) {
            foreach (dead : entry.dying) {
                // UnitGroup이 이 블록 끝에서 죽은 항목을 제거합니다.
            }
            const unit = CUnit.cast(entry.epd);
            const owner = unit.owner;
            if (owner >= 7) { continue; }
            if (owner != player) { continue; }
            recoveryCamp.heal(unit, owner);
            if (!hasCommand) { continue; }
            const mode = COMMANDS[owner];
            if (mode == 0) { continue; }
            if (mode == 2) { orders.issue(unit, orders.ORDER_ATTACK_MOVE, TARGET_POSITIONS[owner]); }
            else { orders.issue(unit, orders.ORDER_MOVE, TARGET_POSITIONS[owner]); }
        }
    }
    setcurpl(0);
}
