import modules.settings as cfg;

const NEXT_UNIT = EPD(0x628438);
const ORDER_OFFSET = 0x4C / 4;
const ORDER_MASK = 0xFF00;
const WAR_TIMER_OFFSET = 0x8C / 4;
const CITY_HEALTH_LOCATION = 234;
const CITY_UNITS = EUDVArray(cfg.CITY_COUNT, CUnit)();
const DEFENDERS = EUDVArray(cfg.CITY_COUNT * cfg.GUARDS, CUnit)();
const DEFENDER_GENERATION = EUDArray(cfg.CITY_COUNT * cfg.GUARDS);
const DEFENDER_COUNT = EUDArray(cfg.CITY_COUNT);
const cityCount = EUDVArray(8)();
var registeredCities = 0;

function init() {
    foreach (marker : EUDLoopCUnit()) {
        if (marker.unitType == 195 && marker.owner == 7) {
            marker.setloc(254);
            dilateloc(254, 16, 16);
            marker.remove();
            if (!MemoryEPD(NEXT_UNIT, Exactly, 0)) {
                const city = CUnit.from_next();
                CreateUnit(1, 156, 254, 7);
                if (!MemoryXEPD(city + 0x4C / 4, Exactly, 0, 0xFF00)) {
                    city.statusFlags.Invincible = true;
                    city.orderID = 18;
                    city.unknown0x8C = 0;
                    CITY_UNITS[registeredCities] = city;
                    registeredCities++;
                }
            }
        }
    }
}

function grant(index, player) {
    // Starting-region assignment only. Combat transfers the exact stored CUnit.
    const loc = cfg.locations[index];
    const count = cfg.weights[index];
    GiveUnits(All, 156, 7, loc, player);
    if (player < 7) { cityCount[player] += count; }
}

function defend(index, owner) {
    // One city CUnit, six guards. Location 232 is positioned by tick().
    const base = index * cfg.GUARDS;
    var created = 0;
    for (var i = 0; i < cfg.GUARDS; i++) {
            if (MemoryEPD(NEXT_UNIT, Exactly, 0)) { break; }
            const guard = CUnit.from_next();
            CreateUnit(1, 40, 232, owner);
            if (!MemoryXEPD(guard + 0x4C / 4, Exactly, 0, 0xFF00)) {
                guard.statusFlags.InAir = false;
                guard.pathingFlags = 1;
                guard.movementState = 10;
                guard.statusFlags.IsNormal = true;
                DEFENDERS[base + created] = guard;
                DEFENDER_GENERATION[base + created] = guard.uniquenessIdentifier;
                created++;
            }
            addloc(232, 16, 0);
    }
    DEFENDER_COUNT[index] = created;
}

function withdraw(index) {
    // Remove only this city's surviving guards; never sweep neighboring guards.
    const base = index * cfg.GUARDS;
    const count = DEFENDER_COUNT[index];
    DEFENDER_COUNT[index] = 0;
    for (var i = 0; i < count; i++) {
        const guard = DEFENDERS[base + i];
            if (MemoryXEPD(guard + 0x64 / 4, Exactly, 40, 0xFFFF) &&
                !MemoryXEPD(guard + ORDER_OFFSET, Exactly, 0, ORDER_MASK) &&
                guard.uniquenessIdentifier == DEFENDER_GENERATION[base + i]) {
                guard.remove();
            }
    }
}

function mostPlayerAt(loc : TrgLocation) {
    var result = 8;
    foreach (cp : EUDLoopPlayer(None)) {
        setcurpl(cp);
        if (CommandMostAt("Men", loc) && Bring(CurrentPlayer, AtLeast, 1, "Men", loc)) {
            result = cp;
            break;
        }
    }
    return result;
}

function tick() {
    // Every registered city is handled in this tick. No global-unit scan or slicing.
    for (var index = 0; index < registeredCities; index++) {
        const city = CITY_UNITS[index];
        if (MemoryXEPD(city + ORDER_OFFSET, Exactly, 0, ORDER_MASK)) { continue; }
        const owner = city.owner;
        const isAttacking = l2v(MemoryXEPD(city + ORDER_OFFSET, Exactly, 19 << 8, ORDER_MASK));
        const timer = city.unknown0x8C;
        const x, y = posread_epd(city + 0x28 / 4);
        setloc(233, x, y);
        dilateloc(233, 160, 160);
        if (owner < 7 && !f_playerexist(owner)) {
            withdraw(index);
            city.cgive(7);
            cityCount[owner]--;
            city.unknown0x8C = 0;
            city.setloc(CITY_HEALTH_LOCATION);
            ModifyUnitHitPoints(1, 156, 7, CITY_HEALTH_LOCATION, 100);
            continue;
        }
        if (isAttacking && timer == 0) {
            setloc(232, x - 32, y + 32);
            dilateloc(232, 32, 32);
            defend(index, owner);
            city.setloc(CITY_HEALTH_LOCATION);
            ModifyUnitHitPoints(1, 156, owner, CITY_HEALTH_LOCATION, 30);
            city.unknown0x8C = cfg.PEACE_TIMEOUT;
            continue;
        }
        if (!isAttacking && timer == 1) {
            withdraw(index);
            city.setloc(CITY_HEALTH_LOCATION);
            ModifyUnitHitPoints(1, 156, owner, CITY_HEALTH_LOCATION, 100);
            city.unknown0x8C = 0;
            continue;
        }
        // FranceDp checks capture throughout battle, including attack-order gaps.
        if (timer != 0 && Bring(owner, AtMost, 0, "Men", 233)) {
            const winner = mostPlayerAt(233);
            if (winner < 8 && winner != owner) {
                withdraw(index);
                city.cgive(winner);
                if (owner < 7) { cityCount[owner]--; }
                if (winner < 7) { cityCount[winner]++; }
                city.setloc(CITY_HEALTH_LOCATION);
                ModifyUnitHitPoints(1, 156, winner, CITY_HEALTH_LOCATION, 100);
                ModifyUnitShields(1, 156, winner, CITY_HEALTH_LOCATION, 100);
                city.unknown0x8C = 0;
                setcurpl(winner);
                println("\x04도시 점령! 보유 도시: {}", cityCount[winner]);
                continue;
            }
        }
        if (timer > 1) {
            if (isAttacking) { city.unknown0x8C = cfg.PEACE_TIMEOUT; }
            else { city.unknown0x8C = timer - 1; }
        }
    }
    setcurpl(0);
}
