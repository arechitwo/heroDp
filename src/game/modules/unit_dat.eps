// 도시 파일런(156)과 주둔군 브루들링(40)만 수정합니다.
// 게임 시작 시 cities.init()보다 먼저 실행: 외형/공격 AI 설정 후 비콘을 파일런으로 변환.
import modules.unit_settings.UnitModel as UnitModel;
function init() {
    // ---- 도시: 프로토스 파일런 ----
    UnitModel.small_city.flingy = 62;                    // 원본 파일런 외형
    UnitModel.small_city.buildingDimensions = 32 + (32 << 16); // One-tile placement box
    UnitModel.small_city.unitBoundsL = 15;
    UnitModel.small_city.unitBoundsT = 15;
    UnitModel.small_city.unitBoundsR = 16;
    UnitModel.small_city.unitBoundsB = 16;
    UnitModel.small_city.maxHp = 2000 * 256;             // 체력: 반드시 256을 곱함
    UnitModel.small_city.hasShield = true;
    UnitModel.small_city.maxShield = 300;
    UnitModel.small_city.armor = 25;
    UnitModel.small_city.seekRange = 7;                  // Acquisition range, tiles
    UnitModel.small_city.computerIdleOrder = 18;         // Tower Guard
    UnitModel.small_city.humanIdleOrder = 18;
    UnitModel.small_city.returnToIdleOrder = 18;
    UnitModel.small_city.attackUnitOrder = 19;           // 건물 공격 상태: 주둔군 생성 판정
    UnitModel.small_city.attackMoveOrder = 18;
    UnitModel.small_city.baseProperty = 0x54000001;      // FranceDp building + CanAttack
    UnitModel.small_city.groundWeapon = 117;
    UnitModel.small_city.airWeapon = 117;
    Weapon(117).minRange = 64;
    Weapon(117).maxRange = 576;                 // FranceDp city range, 18 tiles
    Weapon(117).cooldown = 18;
    Weapon(117).damage = 0;                     // 적 감지용. 도시 자체 피해는 없음
    Weapon(117).damageBonus = 0;
    Weapon(117).targetFlags = 2;                // Ground targets

    // ---- 주둔군: 유닛 ID는 브루들링, 외형은 마린 ----
    UnitModel.defender.flingy = 78;                    // 마린 외형 공유. 실제 마린 DAT는 수정하지 않음
    UnitModel.defender.portrait = 0;                   // Marine portrait
    UnitModel.defender.readySound = 275;
    UnitModel.defender.whatSoundStart = 287;
    UnitModel.defender.whatSoundEnd = 290;
    UnitModel.defender.pissedSoundStart = 280;
    UnitModel.defender.pissedSoundEnd = 283;
    UnitModel.defender.yesSoundStart = 291;
    UnitModel.defender.yesSoundEnd = 294;
    UnitModel.defender.buildingDimensions = 17 + (20 << 16);
    UnitModel.defender.unitBoundsL = 9;
    UnitModel.defender.unitBoundsT = 9;
    UnitModel.defender.unitBoundsR = 9;
    UnitModel.defender.unitBoundsB = 10;
    UnitModel.defender.baseProperty = 0x18010204;       // FranceDp guard flags
    UnitModel.defender.computerIdleOrder = 107;         // Hold Position
    UnitModel.defender.humanIdleOrder = 107;
    UnitModel.defender.returnToIdleOrder = 107;
    UnitModel.defender.attackUnitOrder = 19;            // Stationary tower attack
    UnitModel.defender.attackMoveOrder = 23;            // Nothing; no attack-move
    UnitModel.defender.dontBecomeGuard = true;
    UnitModel.defender.ignoreStrategicSuicideMissions = true;
    UnitModel.defender.rightClickAction = 3;            // FranceDp stationary attack
    UnitModel.defender.seekRange = 9;
    UnitModel.defender.sightRange = 9;
    UnitModel.defender.maxHp = 2000 * 256;             // FranceDp 주둔군 CSV 기준 체력
    UnitModel.defender.armor = 9;
    UnitModel.defender.armorUpgrade = 0;
    UnitModel.defender.groundWeapon = 119;
    UnitModel.defender.airWeapon = 119;
    UnitModel.defender.maxAirHits = 1;
    UnitModel.defender.supplyUsed = 0;
    UnitModel.defender.transportSpaceRequired = 255;    // Cannot load garrisons
    UnitModel.defender.mineralCost = 100;
    UnitModel.defender.gasCost = 0;
    UnitModel.defender.timeCost = 9999;
    UnitModel.defender.killScore = 2;
    Weapon(119).damage = 80;
    Weapon(119).damageBonus = 3;
    Weapon(119).maxRange = 208;
    Weapon(119).minRange = 0;
    Weapon(119).cooldown = 15;
    Weapon(119).targetFlags = 3;                // Ground and air targets
    Weapon(119).upgrade = 8;

    // 버튼셋은 TrgUnit 멤버가 없어 메모리로 제거: 버튼 개수와 포인터를 0으로.
    SetMemory(0x5187E8 + UnitModel.small_city * 12, SetTo, 0);    // Pylon button count
    SetMemory(0x5187E8 + UnitModel.small_city * 12 + 4, SetTo, 0);
    SetMemory(0x5187E8 + UnitModel.defender * 12, SetTo, 0);     // Garrison button count
    SetMemory(0x5187E8 + UnitModel.defender * 12 + 4, SetTo, 0);
}
