// Game entry point. Data plugins run first, in main.eds section order.
// Import gameplay modules from modules/ here.
import modules.cities as cities;
import modules.income as income;
import modules.commander as commander;
import modules.start_ui as ui;
import modules.rules as rules;
import modules.unit_dat as unitDat;
import modules.debug as debug;
import modules.player_settings as playerSettings;
import modules.unit_data as unitData;
function onPluginStart() {
    playerSettings.SetColor(P8, playerSettings.BLACK);
    unitDat.init(); // Runtime DAT first: city/garrison appearance and attack AI.
    unitData.init(); // 기본 병종 CSV 적용. 특수 유닛은 아직 설정하지 않음.
    cities.init();
    randomize();
    ui.init();
}

function beforeTriggerExec() {
    debug.captureChat(); // Local pattern parsing only; MSQC sends it on its next pass.
    debug.tick(); // Consume synchronized debug commands before start UI clears chat.
    ui.tick();
    if (ui.started != 0) {
        rules.tick();
        cities.tick();
        income.tick();
        commander.tick();
    }
}

function afterTriggerExec() {
}
